# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Your MongoDB Atlas connection string 
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/demowebsite?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=change-this-to-something-long-and-random

# Comma separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,https://your-project.vercel.app

PORT=5000
